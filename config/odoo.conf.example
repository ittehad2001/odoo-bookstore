[options]
# Example config for Docker Compose (official odoo image) behind nginx.
# Copy to config/odoo.conf and edit passwords before any real deployment.

admin_passwd = change-me-odoo-master
db_host = db
db_port = 5432
db_user = odoo
db_password = change-me-db-password
addons_path = /mnt/extra-addons
http_port = 8069

# Required when Odoo sits behind a reverse proxy (nginx).
proxy_mode = True

# Single-DB friendly; nginx also sends X-Odoo-Database for /api.
list_db = True
without_demo = False
