# Multi-stage: build Ink & Spine, then serve behind nginx with Odoo reverse-proxy.
FROM node:20-alpine AS build
WORKDIR /app

COPY bookstore-web/package.json bookstore-web/package-lock.json ./
RUN npm ci

COPY bookstore-web/ ./
ARG VITE_CHECKOUT_API_KEY=dev-bookstore-key-change-me
ENV VITE_API_BASE_URL=
ENV VITE_CHECKOUT_API_KEY=$VITE_CHECKOUT_API_KEY
RUN npm run build

FROM nginx:1.27-alpine
RUN apk add --no-cache bash gettext \
    && rm -f /etc/nginx/conf.d/default.conf
COPY deploy/nginx/default.conf.template /etc/bookstore/default.conf.template
COPY deploy/nginx/docker-entrypoint.sh /docker-entrypoint.d/40-bookstore-envsubst.sh
RUN chmod +x /docker-entrypoint.d/40-bookstore-envsubst.sh
COPY --from=build /app/dist /usr/share/nginx/html

ENV ODOO_UPSTREAM=web:8069
ENV ODOO_DB_NAME=odoo_dev
EXPOSE 80
