# Copy to .env and change every secret before sharing or deploying.
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=postgres

# Master password for Odoo database manager (/web/database/manager).
ODOO_ADMIN_PASSWD=change-me-odoo-master

# Database name created in Odoo (must match nginx X-Odoo-Database).
ODOO_DB_NAME=odoo_dev

# Public entrypoint (nginx). Odoo :8069 stays internal.
PROXY_HTTP_PORT=8080

# Must match Odoo System Parameter bookstore_api.checkout_key
BOOKSTORE_CHECKOUT_KEY=dev-bookstore-key-change-me

# Optional: only if you temporarily publish raw Odoo for debugging.
# ODOO_HTTP_PORT=8069
