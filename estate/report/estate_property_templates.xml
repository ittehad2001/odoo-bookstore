<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Reusable offers table (PDF tutorial — sub-template) -->
    <template id="report_property_offer_table">
        <t t-if="not property.offer_ids">
            <p>There are no offers yet for this property.</p>
        </t>
        <t t-else="">
            <table class="table table-sm o_main_table">
                <thead>
                    <tr>
                        <th>Price</th>
                        <th>Partner</th>
                        <th>Status</th>
                        <th>Deadline</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="property.offer_ids" t-as="offer">
                        <td><span t-field="offer.price"/></td>
                        <td><span t-field="offer.partner_id"/></td>
                        <td><span t-field="offer.status"/></td>
                        <td><span t-field="offer.date_deadline"/></td>
                    </tr>
                </tbody>
            </table>
        </t>
    </template>

    <template id="report_property_offers">
        <t t-foreach="docs" t-as="property">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <span t-field="property.name"/>
                        </h2>
                        <div class="mb-2">
                            <strong>Expected Price: </strong>
                            <span t-field="property.expected_price"/>
                        </div>
                        <div class="mb-2" t-if="property.property_type_id">
                            <strong>Type: </strong>
                            <span t-field="property.property_type_id"/>
                        </div>
                        <div class="mb-2" t-if="property.state">
                            <strong>State: </strong>
                            <span t-field="property.state"/>
                        </div>
                        <h3 class="mt-3">Offers</h3>
                        <t t-call="estate.report_property_offer_table"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Salesperson: all available properties + their offers -->
    <template id="report_user_properties">
        <t t-foreach="docs" t-as="user">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            Properties for
                            <span t-field="user.name"/>
                        </h2>
                        <t t-if="not user.property_ids">
                            <p>No available properties for this salesperson.</p>
                        </t>
                        <t t-foreach="user.property_ids" t-as="property">
                            <h3 class="mt-4">
                                <span t-field="property.name"/>
                            </h3>
                            <div class="mb-2">
                                <strong>Expected Price: </strong>
                                <span t-field="property.expected_price"/>
                            </div>
                            <t t-call="estate.report_property_offer_table"/>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
